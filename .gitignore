# Secrets
.env

# Input data — the ticket export contains customer PII, never commit it
data/*
!data/.gitkeep

# Extraction output — regenerable, and also contains ticket content
results/*
!results/.gitkeep
!results/raw/.gitkeep
results/raw/*
!results/raw/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/
