# Secrets
.env

# Input data — the ticket export contains customer PII, never commit it
data/*
!data/.gitkeep

# Extraction output — regenerable, and also contains ticket content
results/*
!results/.gitkeep
!results/raw/.gitkeep
results/raw/*
!results/raw/.gitkeep

# Visualization build artifacts — regenerable, and derived from the PII-bearing
# .xls (they embed customer company names + effort aggregates). Rebuild with
# `make explorer`.
distributional_shape_explorer.html
merged_data.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

